COMPOSE_PROJECT_NAME=vulnerableapp-academy
LAB_PORT=8080
OLLAMA_IMAGE=ollama/ollama:0.40.13
OLLAMA_MODEL=huihui_ai/Qwen3.8-abliterated:27b
# Perfil 27B: configura suficiente RAM en la VM Docker antes de arrancar.
# El límite de memoria no reserva RAM; los pesos y contexto requieren más que la descarga.
OLLAMA_CPUS=12.0
OLLAMA_MEMORY=48g
OLLAMA_NUM_THREADS=12
OLLAMA_CONTEXT_LENGTH=16384
HARNESS_UPSTREAM_TIMEOUT=1800
ACADEMY_CPUS=2.0
ACADEMY_MEMORY=2g
KALI_CPUS=4.0
KALI_MEMORY=6g
TARGET_CPUS=2.0
TARGET_MEMORY=1g
