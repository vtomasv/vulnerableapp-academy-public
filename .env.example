COMPOSE_PROJECT_NAME=vulnerableapp-academy
LAB_PORT=8080
OLLAMA_IMAGE=ollama/ollama:0.12.11
OLLAMA_MODEL=huihui_ai/qwen3-abliterated:1.7b-v2-q4_K_M
# Ajusta estos límites si Docker Desktop tiene menos/más memoria disponible.
# El modelo Qwen puede necesitar varios GB durante la descarga y la inferencia.
ACADEMY_CPUS=2.0
ACADEMY_MEMORY=2g
KALI_CPUS=2.0
KALI_MEMORY=3g
OLLAMA_CPUS=4.0
OLLAMA_MEMORY=8g
