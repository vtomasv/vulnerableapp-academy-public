# syntax=docker/dockerfile:1.7
ARG OLLAMA_IMAGE=ollama/ollama:0.40.13

FROM python:3.12-alpine AS init
RUN addgroup -S init && adduser -S -G init init
COPY scripts/init-secrets.py /usr/local/bin/init-secrets.py
RUN chmod 0755 /usr/local/bin/init-secrets.py
ENTRYPOINT ["python3", "/usr/local/bin/init-secrets.py"]

FROM ${OLLAMA_IMAGE} AS model-init
COPY scripts/model-init.sh /usr/local/bin/model-init.sh
RUN chmod 0755 /usr/local/bin/model-init.sh
ENTRYPOINT ["/usr/local/bin/model-init.sh"]
